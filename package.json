{
  "name": "accesslink",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx scripts/emit-fixtures.ts && vitest run",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx src/server.ts",
    "seed:demo": "tsx src/infrastructure/db/seed-demo.ts",
    "emit:fixtures": "tsx scripts/emit-fixtures.ts",
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "test:e2e": "playwright test",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "pg": "^8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
